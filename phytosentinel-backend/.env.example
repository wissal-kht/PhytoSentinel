# PhytoSentinel — Configuration Environnement
# Copier ce fichier en .env et remplir les valeurs

# --- Base de données MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD= 
DB_NAME=phytosentinel

# --- API OpenWeatherMap ---
# Obtenir gratuitement sur https://openweathermap.org/api
# Si vide, le système utilise des données simulées
OWM_API_KEY=votre_cle_api_ici

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=1
